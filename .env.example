# Production environment template (Railway / Render / VPS).
# Copy every variable into your platform's secret store — never commit .env.
# All variables are validated at boot by src/config/env.ts; the process exits
# if any are missing or malformed.

NODE_ENV=production

# Listen port. Railway/Render inject PORT automatically; keep the default.
PORT=3000

# Managed Postgres (Neon / Railway Postgres / Render Postgres). Use the
# pooled connection string if the provider offers one.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public

# Session hashing pepper — min 16 chars, generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating this logs out every user.
SESSION_SECRET=<generate-a-long-random-secret>

# AES-256-GCM key (64 hex chars = 32 bytes) encrypting system-settings secrets
# (payment/email credentials). REQUIRED in production — boot fails without it.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating it makes previously stored settings secrets undecryptable.
SETTINGS_ENCRYPTION_KEY=<generate-64-hex-chars>

# The PUBLIC ORIGIN OF THE STOREFRONT (the Vercel URL), with no trailing
# slash. This single value drives three things that must agree:
#   1. CORS allow-list for browser calls (credentials: true)
#   2. Links inside transactional emails (/verify-email, /reset-password, …)
#   3. Same-site cookie pairing with the frontend proxy (see DEPLOYMENT.md §7)
CORS_ORIGIN=https://your-storefront.vercel.app

# Behind PaaS proxies/Railway's edge, set to "1" so rate limiting and session
# logging resolve real client IPs from X-Forwarded-For instead of the proxy IP.
TRUST_PROXY=1

RESEND_API_KEY=<re-resend-production-key>
RESEND_FROM_EMAIL="Ecommerce <noreply@your-domain.com>"

IMAGEKIT_PUBLIC_KEY=<public-key>
IMAGEKIT_PRIVATE_KEY=<private-key>
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your-id

# Rate limits for real traffic (defaults: global 100, login 10, register 20).
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=10
REGISTER_RATE_LIMIT_MAX=20

# CSRF must stay enabled in production — boot fails when explicitly disabled.
ENABLE_CSRF=true

LOG_LEVEL=info
