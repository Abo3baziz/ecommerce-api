generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model cart_items {
  id                  Int              @id(map: "cart_items_pk") @default(autoincrement())
  quantity            Int
  created_at          DateTime         @db.Timestamptz(6)
  updated_at          DateTime         @db.Timestamptz(6)
  carts_id            Int
  product_variants_id Int
  carts               carts            @relation(fields: [carts_id], references: [id], map: "fk_cart_items_carts")
  product_variants    product_variants @relation(fields: [product_variants_id], references: [id], map: "fk_cart_items_product_variants")

  @@index([carts_id], map: "idx_cart_items_cart_id")
  @@index([product_variants_id], map: "idx_cart_items_product_variant_id")
}

model carts {
  id         Int          @id(map: "carts_pk") @default(autoincrement())
  public_id  String       @unique(map: "carts_public_id_unique_key") @db.VarChar(50)
  created_at DateTime     @db.Timestamptz(6)
  updated_at DateTime     @db.Timestamptz(6)
  users_id   Int
  cart_items cart_items[]
  users      users        @relation(fields: [users_id], references: [id], map: "fk_carts_users")

  @@index([public_id], map: "idx_carts_public_id")
  @@index([users_id], map: "idx_carts_user_id")
}

model categories {
  id                 Int                  @id(map: "category_pk") @default(autoincrement())
  public_id          String               @unique(map: "categories_public_id_unique_key") @db.VarChar(50)
  name               String               @unique(map: "categories_name_unique_key") @db.VarChar(255)
  slug               String               @unique(map: "categories_slug_unique_key") @db.VarChar(255)
  description        String?
  is_active          Boolean              @default(true)
  created_at         DateTime             @db.Timestamptz(6)
  updated_at         DateTime             @db.Timestamptz(6)
  deleted_at         DateTime?            @db.Timestamptz(6)
  product_categories product_categories[]

  @@index([name], map: "idx_categories_name")
  @@index([public_id], map: "idx_categories_public_id")
  @@index([slug], map: "idx_categories_slug")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model coupon_usages {
  id              Int      @id(map: "coupon_usages_pk") @default(autoincrement())
  discount_amount Decimal  @db.Decimal(10, 2)
  redeemed_at     DateTime @db.Timestamptz(6)
  users_id        Int
  coupons_id      Int
  orders_id       Int      @unique(map: "coupon_usages__unique_key")
  coupons         coupons  @relation(fields: [coupons_id], references: [id], map: "fk_coupon_usages_coupons")
  orders          orders   @relation(fields: [orders_id], references: [id], map: "fk_coupon_usages_orders")
  users           users    @relation(fields: [users_id], references: [id], map: "fk_coupon_usages_users")

  @@index([coupons_id], map: "idx_coupon_usages_coupon_id")
  @@index([orders_id], map: "idx_coupon_usages_order_id")
  @@index([redeemed_at], map: "idx_coupon_usages_redeemed_at")
  @@index([users_id], map: "idx_coupon_usages_user_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model coupons {
  id                      Int             @id(map: "coupons_pk") @default(autoincrement())
  public_id               String          @unique(map: "coupons_public_id_unique_key") @db.VarChar(50)
  code                    String          @unique(map: "coupons_code_unique_key") @db.VarChar(50)
  discount_type           discount_type
  discount_value          Decimal         @db.Decimal(10, 2)
  minimum_order_amount    Decimal?        @db.Decimal(10, 2)
  maximum_discount_amount Decimal?        @db.Decimal(10, 2)
  usage_limit             Int
  usage_limit_per_user    Int
  usage_count             Int
  starts_at               DateTime?       @db.Timestamptz(6)
  expires_at              DateTime?       @db.Timestamptz(6)
  is_active               Boolean         @default(true)
  created_at              DateTime        @db.Timestamptz(6)
  updated_at              DateTime        @db.Timestamptz(6)
  deleted_at              DateTime?       @db.Timestamptz(6)
  coupon_usages           coupon_usages[]
  orders                  orders[]

  @@index([code], map: "idx_coupons_code")
  @@index([expires_at], map: "idx_coupons_expires_at")
  @@index([is_active], map: "idx_coupons_is_active")
  @@index([public_id], map: "idx_coupons_public_id")
  @@index([starts_at], map: "idx_coupons_starts_at")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model inventory {
  id                  Int              @id(map: "inventory_pk") @default(autoincrement())
  quantity_on_hand    Int
  reorder_level       Int?
  quantity_reserved   Int?
  created_at          DateTime         @db.Timestamptz(6)
  last_stock_update   DateTime         @db.Timestamptz(6)
  product_variants_id Int              @unique(map: "inventory__unique_key")
  product_variants    product_variants @relation(fields: [product_variants_id], references: [id], map: "fk_inventory_product_variants")

  @@index([product_variants_id], map: "idx_inventory_product_variant_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model order_items {
  id                  Int              @id(map: "order_items_pk") @default(autoincrement())
  quantity            Int
  unit_price          Decimal          @db.Decimal(10, 2)
  total_amount        Decimal          @db.Decimal(10, 2)
  created_at          DateTime         @db.Timestamptz(6)
  orders_id           Int
  product_variants_id Int
  deleted_at          DateTime?        @db.Timestamptz(6)
  orders              orders           @relation(fields: [orders_id], references: [id], map: "fk_order_items_orders")
  product_variants    product_variants @relation(fields: [product_variants_id], references: [id], map: "fk_order_items_product_variants")

  @@index([orders_id], map: "idx_order_items_order_id")
  @@index([product_variants_id], map: "idx_order_items_product_variant_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model orders {
  id                Int            @id(map: "orders_pk") @default(autoincrement())
  public_id         String         @unique(map: "orders_public_id_unique_key") @db.VarChar(50)
  status            order_status
  shipping_cost     Decimal        @db.Decimal(10, 2)
  subtotal          Decimal        @db.Decimal(10, 2)
  order_number      String         @unique(map: "orders_order_number_unique_key") @db.VarChar(50)
  discount_amount   Decimal        @db.Decimal(10, 2)
  shipping_fee      Decimal        @db.Decimal(10, 2)
  tax_amount        Decimal        @db.Decimal(10, 2)
  total_amount      Decimal        @db.Decimal(10, 2)
  notes             String?
  placed_at         DateTime       @db.Timestamptz(6)
  created_at        DateTime       @db.Timestamptz(6)
  updated_at        DateTime       @db.Timestamptz(6)
  users_id          Int
  coupons_id        Int?
  user_addresses_id Int
  coupon_usages     coupon_usages?
  order_items       order_items[]
  coupons           coupons?       @relation(fields: [coupons_id], references: [id], map: "fk_orders_coupons")
  user_addresses    user_addresses @relation(fields: [user_addresses_id], references: [id], map: "fk_orders_user_addresses")
  users             users          @relation(fields: [users_id], references: [id], map: "fk_orders_users")
  shipments         shipments?

  @@index([coupons_id], map: "idx_orders_coupon_id")
  @@index([order_number], map: "idx_orders_order_number")
  @@index([placed_at], map: "idx_orders_placed_at")
  @@index([public_id], map: "idx_orders_public_id")
  @@index([status], map: "idx_orders_status")
  @@index([user_addresses_id], map: "idx_orders_user_address_id")
  @@index([users_id], map: "idx_orders_user_id")
}

model password_reset_tokens {
  id         Int       @id(map: "password_reset_tokens_pk") @default(autoincrement())
  public_id  String    @unique(map: "password_reset_tokens_public_id_unique_key") @db.VarChar(50)
  token_hash String?   @db.VarChar(255)
  expires_at DateTime  @db.Timestamptz(6)
  used_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @db.Timestamptz(6)
  users_id   Int
  users      users     @relation(fields: [users_id], references: [id], map: "fk_password_reset_tokens_users")

  @@index([expires_at], map: "idx_password_reset_tokens_expires_at")
  @@index([public_id], map: "idx_password_reset_tokens_public_id")
  @@index([token_hash], map: "idx_password_reset_tokens_token_hash")
  @@index([users_id], map: "idx_password_reset_tokens_user_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model payments {
  id                    Int       @id(map: "payments_pk") @default(autoincrement())
  amount                Decimal   @db.Decimal(10, 2)
  payment_method        String    @db.VarChar(50)
  payment_status        String    @db.VarChar(30)
  transaction_reference String?   @db.VarChar(255)
  paid_at               DateTime? @db.Timestamptz(6)
  created_at            DateTime  @db.Timestamptz(6)
  updated_at            DateTime  @db.Timestamptz(6)
  users_id              Int
  deleted_at            DateTime? @db.Timestamptz(6)
  users                 users     @relation(fields: [users_id], references: [id], map: "fk_payments_users")
}

model product_categories {
  id            Int        @id(map: "product_categories_pk") @default(autoincrement())
  created_at    DateTime   @db.Timestamptz(6)
  categories_id Int
  products_id   Int
  categories    categories @relation(fields: [categories_id], references: [id], map: "fk_product_categories_categories")
  products      products   @relation(fields: [products_id], references: [id], map: "fk_product_categories_products")

  @@unique([categories_id, products_id], map: "product_categories_product_id_category_id_unique_key")
  @@index([categories_id], map: "idx_product_categories_category_id")
  @@index([products_id], map: "idx_product_categories_product_id")
}

model product_images {
  id            Int      @id(map: "product_images_pk") @default(autoincrement())
  products_id   Int
  public_id     String   @unique(map: "product_images_public_id_unique_key") @db.VarChar(50)
  image_url     String   @db.VarChar(2048)
  is_primary    Boolean
  display_order Int
  alt_text      String?
  created_at    DateTime @db.Timestamptz(6)
  updated_at    DateTime @db.Timestamptz(6)
  products      products @relation(fields: [products_id], references: [id], map: "fk_product_images_products")

  @@index([display_order], map: "idx_product_images_display_order")
  @@index([products_id], map: "idx_product_images_product_id")
  @@index([public_id], map: "idx_product_images_public_id")
}

model product_variant_images {
  id                  Int              @id(map: "product_variant_images_pk") @default(autoincrement())
  public_id           String           @unique(map: "product_variant_images_public_id_unique_key") @db.VarChar(50)
  image_url           String           @db.VarChar(2048)
  product_variants_id Int
  display_order       Int
  alt_text            String?          @db.VarChar(255)
  product_variants    product_variants @relation(fields: [product_variants_id], references: [id], map: "fk_product_variant_images_product_variants")

  @@index([display_order], map: "idx_product_variant_images_display_order")
  @@index([product_variants_id], map: "idx_product_variant_images_product_variant_id")
  @@index([public_id], map: "idx_product_variant_images_public_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model product_variants {
  id                     Int                      @id(map: "product_variants_pk") @default(autoincrement())
  public_id              String                   @unique(map: "product_variants_public_id_unique_key") @db.VarChar(50)
  price                  Decimal                  @db.Decimal(10, 2)
  discount_percentage    Decimal?                 @db.Decimal(5, 2)
  color                  String?                  @db.VarChar(50)
  size                   String?                  @db.VarChar(50)
  status                 product_status?
  sku                    String                   @unique(map: "product_variants_sku_unique_key") @db.VarChar(80)
  barcode                String?
  cost_price             Decimal?                 @db.Decimal(10, 2)
  weight                 Decimal?                 @db.Decimal(10, 2)
  width                  Decimal?                 @db.Decimal(10, 2)
  height                 Decimal?                 @db.Decimal(10, 2)
  length                 Decimal?                 @db.Decimal(10, 2)
  created_at             DateTime                 @db.Timestamptz(6)
  updated_at             DateTime                 @db.Timestamptz(6)
  deleted_at             DateTime?                @db.Timestamptz(6)
  products_id            Int
  cart_items             cart_items[]
  inventory              inventory?
  order_items            order_items[]
  product_variant_images product_variant_images[]
  products               products                 @relation(fields: [products_id], references: [id], map: "fk_product_variants_products")

  @@index([price], map: "idx_product_variants_price")
  @@index([products_id], map: "idx_product_variants_product_id")
  @@index([public_id], map: "idx_product_variants_public_id")
  @@index([sku], map: "idx_product_variants_sku")
}

model products {
  id                 Int                  @id(map: "products_pk") @default(autoincrement())
  public_id          String               @unique(map: "products_public_id_unique_key") @db.VarChar(50)
  name               String               @db.VarChar(255)
  slug               String               @unique(map: "products_slug_unique_key") @db.VarChar(255)
  description        String?
  brand              String?              @db.VarChar(255)
  created_at         DateTime             @db.Timestamptz(6)
  updated_at         DateTime             @db.Timestamptz(6)
  deleted_at         DateTime?            @db.Timestamptz(6)
  product_categories product_categories[]
  product_images     product_images[]
  product_variants   product_variants[]
  reviews            reviews[]

  @@index([brand], map: "idx_products_brand")
  @@index([name], map: "idx_products_name")
  @@index([public_id], map: "idx_products_public_id")
  @@index([slug], map: "idx_products_slug")
}

model review_images {
  id            Int      @id(map: "review_images_pk") @default(autoincrement())
  image_url     String
  alt_text      String?  @db.VarChar(255)
  display_order Int?
  created_at    DateTime @db.Timestamptz(6)
  updated_at    DateTime @db.Timestamptz(6)
  reviews_id    Int?
  public_id     String   @unique(map: "review_images_public_id_unique_key") @db.VarChar(50)
  reviews       reviews? @relation(fields: [reviews_id], references: [id], map: "fk_review_images_reviews")

  @@index([display_order], map: "idx_review_images_display_order")
  @@index([public_id], map: "idx_review_images_public_id")
  @@index([reviews_id], map: "idx_review_images_review_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model reviews {
  id            Int             @id(map: "reviews_pk") @default(autoincrement())
  public_id     String          @unique(map: "reviews_public_id_unique_key") @db.VarChar(50)
  rating        Int             @db.SmallInt
  title         String?         @db.VarChar(255)
  comment       String?
  created_at    DateTime        @db.Timestamptz(6)
  updated_at    DateTime        @db.Timestamptz(6)
  deleted_at    DateTime?       @db.Timestamptz(6)
  is_approved   Boolean         @default(true)
  users_id      Int
  products_id   Int
  review_images review_images[]
  products      products        @relation(fields: [products_id], references: [id], map: "fk_reviews_products")
  users         users           @relation(fields: [users_id], references: [id], map: "fk_reviews_users")

  @@index([is_approved], map: "idx_reviews_is_approved")
  @@index([products_id], map: "idx_reviews_product_id")
  @@index([public_id], map: "idx_reviews_public_id")
  @@index([rating], map: "idx_reviews_rating")
  @@index([users_id], map: "idx_reviews_user_id")
}

model sessions {
  id                 Int       @id(map: "sessions_pk") @default(autoincrement())
  public_id          String    @unique(map: "sessions_public_id_unique_key") @db.VarChar(32)
  refresh_token_hash String    @db.VarChar(255)
  expires_at         DateTime  @db.Timestamptz(6)
  revoked_at         DateTime? @db.Timestamptz(6)
  created_at         DateTime  @db.Timestamptz(6)
  last_activity_at   DateTime? @db.Timestamptz(6)
  ip_address         String?   @db.Inet
  user_agent         String?
  device_name        String?   @db.VarChar(100)
  country            String?   @db.VarChar(100)
  city               String?   @db.VarChar(100)
  is_current         Boolean
  users_id           Int
  users              users     @relation(fields: [users_id], references: [id], map: "fk_sessions_users")

  @@index([expires_at], map: "idx_sessions_expires_at")
  @@index([public_id], map: "idx_sessions_public_id")
  @@index([refresh_token_hash], map: "idx_sessions_refresh_token_hash")
  @@index([users_id], map: "idx_sessions_user_id")
}

model shipments {
  id              Int       @id(map: "shipments_pk") @default(autoincrement())
  public_id       String    @unique(map: "shipments_public_id_unique_key") @db.VarChar(50)
  status          String    @db.VarChar(30)
  carrier         String?   @db.VarChar(100)
  tracking_number String?   @unique(map: "shipments_tracking_number_unique_key") @db.VarChar(100)
  created_at      DateTime  @db.Timestamptz(6)
  shipped_at      DateTime? @db.Timestamptz(6)
  delivered_at    DateTime? @db.Timestamptz(6)
  updated_at      DateTime  @db.Timestamptz(6)
  orders_id       Int       @unique(map: "shipments__unique_key")
  deleted_at      DateTime? @db.Timestamptz(6)
  orders          orders    @relation(fields: [orders_id], references: [id], map: "fk_shipments_orders")

  @@index([orders_id], map: "idx_shipments_order_id")
  @@index([public_id], map: "idx_shipments_public_id")
  @@index([status], map: "idx_shipments_status")
  @@index([tracking_number], map: "idx_shipments_tracking_number")
}

model user_addresses {
  id                  Int       @id(map: "user_addresses_pk") @default(autoincrement())
  public_id           String    @unique(map: "user_addresses_public_id_unique_key") @db.VarChar(50)
  recipient_name      String    @db.VarChar(100)
  phone_number        String    @db.VarChar(20)
  label               String?   @db.VarChar(50)
  country             String    @db.VarChar(100)
  state               String    @db.VarChar(100)
  city                String    @db.VarChar(100)
  address_1           String
  address_2           String?
  zip_code            String?   @db.VarChar(20)
  users_id            Int
  is_default_shipping Boolean   @default(true)
  is_default_billing  Boolean   @default(true)
  created_at          DateTime  @db.Timestamptz(6)
  updated_at          DateTime  @db.Timestamptz(6)
  deleted_at          DateTime? @db.Timestamptz(6)
  orders              orders[]
  users               users     @relation(fields: [users_id], references: [id], map: "fk_user_addresses_users")

  @@index([is_default_billing], map: "idx_user_addresses_default_billing")
  @@index([is_default_shipping], map: "idx_user_addresses_default_shipping")
  @@index([deleted_at], map: "idx_user_addresses_deleted_at")
  @@index([public_id], map: "idx_user_addresses_public_id")
  @@index([users_id], map: "idx_user_addresses_user_id")
}

model users {
  id                    Int                     @id(map: "users_pk") @default(autoincrement())
  public_id             String                  @unique(map: "users_public_id_unique_key") @db.VarChar(32)
  email                 String                  @unique(map: "users_email_unique_key") @db.VarChar(320)
  phone_number          String                  @unique(map: "users_phone_number_unique_key") @db.VarChar(20)
  first_name            String                  @db.VarChar(100)
  last_name             String                  @db.VarChar(100)
  password_hash         String                  @db.VarChar(255)
  email_verified_at     DateTime?               @db.Timestamp(6)
  phone_verified_at     DateTime?               @db.Timestamp(6)
  role                  user_role
  status                user_status
  created_at            DateTime                @db.Timestamptz(6)
  updated_at            DateTime                @db.Timestamptz(6)
  deleted_at            DateTime?               @db.Timestamptz(6)
  carts                 carts[]
  coupon_usages         coupon_usages[]
  orders                orders[]
  password_reset_tokens password_reset_tokens[]
  payments              payments[]
  reviews               reviews[]
  sessions              sessions[]
  user_addresses        user_addresses[]
  verification_tokens   verification_tokens[]

  @@index([email], map: "idx_users_email")
  @@index([public_id], map: "idx_users_public_id")
}

model verification_tokens {
  id          Int                @id(map: "verification_tokens_pk") @default(autoincrement())
  public_id   String             @unique(map: "verification_tokens_public_id_unique_key") @db.VarChar(32)
  token_hash  String             @db.VarChar(255)
  used_at     DateTime?          @db.Timestamptz(6)
  created_at  DateTime           @db.Timestamptz(6)
  expires_at  DateTime           @db.Timestamptz(6)
  target      String             @db.VarChar(100)
  purpose     verification_type?
  verified_at DateTime?          @db.Timestamptz(6)
  users_id    Int
  users       users              @relation(fields: [users_id], references: [id], map: "fk_verification_tokens_users")

  @@index([expires_at], map: "idx_verification_tokens_expires_at")
  @@index([public_id], map: "idx_verification_tokens_public_id")
  @@index([token_hash], map: "idx_verification_tokens_token_hash")
  @@index([users_id], map: "idx_verification_tokens_user_id")
  @@index([purpose], map: "idx_verification_tokens_verification_type")
}

enum discount_type {
  FIXED_AMOUNT
  PERCENTAGE
}

enum order_status {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
  REFUNDED
}

enum product_status {
  ACTIVE
  DRAFT
  INACTIVE
  ARCHIVED
}

enum session_status {
  ACTIVE
  REVOKED
  EXPIRED
}

enum user_role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

enum user_status {
  ACTIVE
  SUSPENDED
  DELETED
}

enum verification_type {
  REGISTER_EMAIL
  CHANGE_EMAIL
  PASSWORD_RESET
  CHANGE_PHONE_NUMBER
}
