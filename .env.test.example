# Test environment configuration.
# Copy to .env.test and adjust the values below before running `npm test`.
# Integration/e2e tests run against this database; all test-created rows use
# emails prefixed with `test-` so the cleanup helper can remove them safely.
NODE_ENV=test
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/Ecommerce_DB?schema=Ecommerce
SESSION_SECRET=<a-random-secret-at-least-16-chars>
CORS_ORIGIN=http://localhost:3000
RESEND_API_KEY=<a-dummy-resend-key>
RESEND_FROM_EMAIL="Ecommerce API <test@example.com>"
IMAGEKIT_PUBLIC_KEY=<a-dummy-imagekit-public-key>
IMAGEKIT_PRIVATE_KEY=<a-dummy-imagekit-private-key>
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/test
# Set high so e2e suites (many logins/registrations from one IP) do not trip
# the login/register IP rate limiters; the 429 behavior has its own dedicated
# suite that overrides these values.
LOGIN_RATE_LIMIT_MAX=100000
REGISTER_RATE_LIMIT_MAX=100000
